{
  "name": "frasberg-botbase",
  "version": "0.1.0",
  "visibility": "private-scaffold",
  "endpoints": {
    "gateway": "http://127.0.0.1:4000",
    "runtimeRouter": "http://127.0.0.1:4001",
    "engine": "http://127.0.0.1:4002",
    "coreSignatureWorker": "${BOTBASE_CORE_SIGNATURE_WORKER_URL}",
    "creatorSignatureWorker": "${BOTBASE_CREATOR_SIGNATURE_WORKER_URL}",
    "infraIpListWorker": "${BOTBASE_INFRA_IP_LIST_WORKER_URL}"
  },
  "modules": [
    "mesh-routing",
    "search",
    "billing",
    "manifest-compilation",
    "compliance",
    "telemetry",
    "policy-governance",
    "identity",
    "cdn",
    "dns-plan-drift",
    "threat-analysis",
    "secrets-vault",
    "ledgers",
    "graph",
    "replication"
  ]
}
