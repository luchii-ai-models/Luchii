{
  "name": "frasberg-monorepo",
  "private": true,
  "version": "6.5.0",
  "description": "Frasberg Backend — Behavioral Governance and Codex Architecture",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "jest",
    "test:codex": "jest tests/codex_architecture",
    "test:packages": "pnpm -r test",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -r lint",
    "governance:mesh": "node cli/frasberg-governance.js mesh:status",
    "governance:bump": "node cli/frasberg-governance.js mesh:bump-version",
    "governance:raft": "node cli/frasberg-governance.js mesh:bump-raft",
    "governance:snapshot": "node cli/frasberg-governance.js mesh:set-snapshot",
    "governance:sync": "node cli/frasberg-governance.js sync:status",
    "license:audit": "node scripts/repo-license-auditor.js",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "release:bundle": "node scripts/package-release.js",
    "release:hash": "node scripts/hash-release.js",
    "release:provenance": "node scripts/generate-provenance.js",
    "release:all": "npm run release:manifest && npm run release:bundle && npm run release:hash && npm run release:provenance"
  },
  "dependencies": {
    "react": "^18.0.0",
    "express": "^4.18.0",
    "@frasberg/governance-engine": "workspace:*",
    "@frasberg/tonal-modulation": "workspace:*",
    "@frasberg/membrane-protocol": "workspace:*",
    "@frasberg/hinge-logic": "workspace:*",
    "@frasberg/unified-field-runtime": "workspace:*",
    "@frasberg/continuum-identity": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/supertest": "^2.0.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
