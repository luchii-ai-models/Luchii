{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Frasberg Game — Live Dashboard",
  "uid": "frasberg-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "tags": ["frasberg", "game", "production"],
  "panels": [
    {
      "id": 1,
      "title": "🟢 Active Players",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "frasberg_active_players",
        "legendFormat": "Players"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 900 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "🔌 WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "frasberg_ws_connections_active",
        "legendFormat": "Connections"
      }],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 950 }
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "💥 Active Police Chases",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "frasberg_active_police_chases",
        "legendFormat": "Chases"
      }]
    },
    {
      "id": 4,
      "title": "🚗 Carjacks Per Minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(frasberg_carjacks_total[1m]) * 60",
        "legendFormat": "Carjacks/min"
      }]
    },
    {
      "id": 5,
      "title": "📡 Messages Per Second",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(frasberg_messages_total[30s])",
        "legendFormat": "Messages/sec"
      }]
    },
    {
      "id": 6,
      "title": "⚡ CPU Usage",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(process_cpu_seconds_total{job='frasberg-game-server'}[5m]) * 100",
        "legendFormat": "CPU %"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "💾 Memory Usage",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "process_resident_memory_bytes{job='frasberg-game-server'} / 1024 / 1024",
        "legendFormat": "Memory MB"
      }]
    },
    {
      "id": 8,
      "title": "🚨 Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(frasberg_ws_errors_total[1m])",
        "legendFormat": "Errors/sec"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    },
    {
      "id": 9,
      "title": "🏆 Active Missions",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "frasberg_active_missions",
        "legendFormat": "Missions"
      }]
    },
    {
      "id": 10,
      "title": "🌍 Players Per Region",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "frasberg_players_by_region",
        "legendFormat": "{{ region }}"
      }]
    }
  ]
}
