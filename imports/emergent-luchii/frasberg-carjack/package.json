{
  "name": "frasberg-carjack",
  "version": "1.0.0",
  "description": "Frasberg Carjack — Professional open-world carjacking game by FRASBERG INC.",
  "author": "Frasberg Selassie <frasberg@frasberginc.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/multiplayer.js",
    "electron": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "mobile:start": "cd mobile && npx expo start",
    "mobile:android": "cd mobile && npx expo run:android",
    "mobile:ios": "cd mobile && npx expo run:ios",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "eslint src --ext .js",
    "test": "vitest run",
    "deploy": "bash infra/deploy.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "prom-client": "^15.1.2",
    "rate-limiter-flexible": "^5.0.3",
    "redis": "^4.6.10",
    "three": "^0.185.1",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.1.8",
    "eslint": "^9.0.0",
    "nodemon": "^3.0.2",
    "terser": "^5.49.1",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "build": {
    "appId": "com.frasberginc.carjack",
    "productName": "Frasberg Carjack",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
