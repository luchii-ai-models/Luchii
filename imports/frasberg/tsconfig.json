{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "*": ["supabase/frasberg/*"]
    },

    "outDir": "./dist",
    "rootDir": ".",
    "types": ["jest", "node"],
    "jsx": "react"
  },

  "include": [
    "src/**/*",
    "tests/**/*",
    "config/**/*",
    "supabase/frasberg",
    "supabase/frasberg/frasberg_application_shell/**/*",
    "supabase/frasberg/frasberg_bootstrap.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",

    "tests/frasberg_ai_application_shell/execution",
    "tests/frasberg_ai_application_shell/pipeline",

    "supabase/frasberg/deviation_engine/index.ts",
    "supabase/frasberg/identity_filter/identity_filter.test.ts",
    "supabase/frasberg/membrane_engine/membrane_engine.test.ts",

    "**/supabase/frasberg/**/supabase/**"
  ]
}
