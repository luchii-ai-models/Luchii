{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRuntimeLogGroups",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-west-2:__AWS_ACCOUNT_ID__:log-group:/ecs/frasberg-secure-runtime"
    },
    {
      "Sid": "WriteRuntimeLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-west-2:__AWS_ACCOUNT_ID__:log-group:/ecs/frasberg-secure-runtime:log-stream:*"
    },
    {
      "Sid": "ReadRuntimeSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-west-2:__AWS_ACCOUNT_ID__:secret:frasberg/SUPABASE_URL-*",
        "arn:aws:secretsmanager:us-west-2:__AWS_ACCOUNT_ID__:secret:frasberg/SUPABASE_ANON_KEY-*",
        "arn:aws:secretsmanager:us-west-2:__AWS_ACCOUNT_ID__:secret:frasberg/runtime/engine-keys-*",
        "arn:aws:secretsmanager:us-west-2:__AWS_ACCOUNT_ID__:secret:frasberg/runtime/governance-admin-*"
      ]
    }
  ]
}
